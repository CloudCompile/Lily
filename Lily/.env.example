# Lily v8.5 Configuration

# ── Discord ──────────────────────────────────────────────
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# ── Pollinations API ─────────────────────────────────────
POLLINATIONS_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_MEDIA_URL=https://media.pollinations.ai

# ── Admin IDs (comma-separated) ──────────────────────────
ADMIN_IDS=

# ── Bot behaviour ────────────────────────────────────────
BOT_PREFIX=!lily

# ── Default models ───────────────────────────────────────
DEFAULT_TEXT_MODEL=openai
DEFAULT_IMAGE_MODEL=flux

# ── v8.5 Features ────────────────────────────────────────
# Proactive DMs (Lily will DM you first)
PROACTIVE_DM_ENABLED=true
# How often to check for proactive DMs (seconds)
PROACTIVE_DM_CHECK_INTERVAL=300

# Daily recaps (Lily writes a diary entry every night)
DAILY_RECAP_ENABLED=true
# What hour to generate recaps (24-hour format)
DAILY_RECAP_HOUR=23
