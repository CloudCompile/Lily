# Lily v9.0 Configuration

# ── Discord ──────────────────────────────────────────────
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# ── Pollinations API ─────────────────────────────────────
POLLINATIONS_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_MEDIA_URL=https://media.pollinations.ai

# ── Admin IDs (comma-separated) ──────────────────────────
ADMIN_IDS=

# ── Bot behaviour ────────────────────────────────────────
BOT_PREFIX=!lily

# ── Default models (v9.0: cheap models by default!) ──────
# Text: openai-fast (free), tomdacatto/ling-3.0-flash (0.1/M), openai (standard)
DEFAULT_TEXT_MODEL=openai-fast
# Image: sana (0.0001/gen!), flux (0.003/gen), gptimage (0.01/gen)
DEFAULT_IMAGE_MODEL=sana

# ── v9.0 Features ────────────────────────────────────────
# Proactive DMs (Lily will DM you first)
PROACTIVE_DM_ENABLED=true
# How often to check for proactive DMs (seconds)
PROACTIVE_DM_CHECK_INTERVAL=300

# Daily recaps (Lily writes a diary entry every night)
DAILY_RECAP_ENABLED=true
# What hour to generate recaps (24-hour format)
DAILY_RECAP_HOUR=23

# Dream journal (Lily writes dreams at night)
DREAM_JOURNAL_ENABLED=true
# What hour Lily dreams (3 AM is the dreamy hour)
DREAM_JOURNAL_HOUR=3

# Mood-reactive Discord status (her status changes with her mood)
MOOD_STATUS_ENABLED=true
# How often to update status (seconds)
MOOD_STATUS_INTERVAL=300
