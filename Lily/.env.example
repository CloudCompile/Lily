# ===========================================
# Lily Discord Bot - Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Pollinations API Key (get one at https://enter.pollinations.ai/keys)
# Optional: Without a key, only free-tier endpoints work.
# sk_* = secret key (server-side), pk_* = publishable key (client-side)
POLLINATIONS_KEY=

# Admin Discord User IDs (comma-separated)
ADMIN_IDS=123456789012345678

# Bot prefix for text commands
BOT_PREFIX=!lily

# Default AI model for text generation
DEFAULT_TEXT_MODEL=openai

# Default model for image generation
DEFAULT_IMAGE_MODEL=zimage

# Default model for video generation
DEFAULT_VIDEO_MODEL=veo

# Default model for TTS
DEFAULT_TTS_MODEL=elevenlabs

# Default model for audio transcription
DEFAULT_TRANSCRIPTION_MODEL=whisper

# Default model for 3D generation
DEFAULT_3D_MODEL=trellis-2-low

# Pollinations API base URL
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_MEDIA_URL=https://media.pollinations.ai
